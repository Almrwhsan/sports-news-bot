{
  "app": {
    "name": "Live Stream Manager",
    "version": "1.2.0",
    "environment": "testing"
  },

  "streams": [
    {
      "id": "sportsone",
      "name": "Sports One",
      "event_title": "Sports One Live",
      "stream_url": "https://5c7b683162943.streamlock.net/live/ngrp:sportsone_all/playlist.m3u8",
      "enabled": true,
      "status": "testing",
      "preferred_variant": 1
    }
  ],

  "headers": {
    "Referer": "https://www.bna.bh",
    "User-Agent": "Mozilla/5.0 (Android 14; Mobile) AppleWebKit/537.36 Chrome/128.0.0.0 Mobile Safari/537.36"
  },

  "monitoring": {
    "enabled": true,
    "interval_seconds": 30,
    "timeout": 15,
    "segment_test_count": 3,
    "segment_test_delay": 2,
    "max_consecutive_failures": 3
  },

  "output": {
    "playlist_file": "live_playlist.m3u",
    "log_directory": "logs",
    "log_file": "stream_manager.log"
  },

  "facebook": {
    "enabled": true,
    "page_id": "",
    "page_access_token": "",
    "post_message": false
  },

  "ffmpeg": {
    "enabled": true,

    "duration_minutes": 10,

    "video": {
      "width": 1920,
      "height": 1080,
      "fps": 25,
      "bitrate": "5000k",
      "maxrate": "5500k",
      "bufsize": "10000k",
      "preset": "veryfast"
    },

    "overlay": {
      "enabled": true,

      "logo": "assets/logo.png",

      "logo_width": 180,

      "logo_position": {
        "x": 35,
        "y": 35
      },

      "frame": {
        "enabled": true,
        "width": 18,
        "color": "0x8B0000"
      },

      "live_badge": {
        "enabled": true,
        "text": "LIVE",
        "x": 35,
        "y": 220,
        "font_size": 42,
        "font_color": "white",
        "box_color": "0x8B0000",
        "box_opacity": 0.85
      }
    },

    "audio": {
      "enabled": true,

      "mode": "normal",

      "volume": 0.85,

      "bass": 0,
      "treble": 0,

      "echo": {
        "enabled": true,
        "in_gain": 0.8,
        "out_gain": 0.7,
        "delays": "900|900",
        "decays": "0.18|0.10"
      }
    }
  }
}
