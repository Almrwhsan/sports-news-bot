{
  "app": {
    "name": "Live Stream Manager",
    "version": "1.3.1",
    "environment": "testing"
  },

  "streams": [
    {
      "id": "authorized_stream",
      "name": "Authorized Live Stream",
      "event_title": "Authorized Live",
      "stream_url": "https://18soso.s3.us-east-2.amazonaws.com/bein1/480p/manifest.m3u8",
      "enabled": true,
      "status": "testing",
      "preferred_variant": 1
    }
  ],

  "headers": {
    "Referer": "",
    "User-Agent": "Mozilla/5.0 (Android 14; Mobile) AppleWebKit/537.36 Chrome/128.0.0.0 Mobile Safari/537.36"
  },

  "monitoring": {
    "enabled": true,
    "interval_seconds": 30,
    "timeout": 15,
    "segment_test_count": 3,
    "segment_test_delay": 2,
    "max_consecutive_failures": 3
  },

  "auto_restart": {
    "enabled": true,
    "restart_delay_seconds": 5,
    "max_restarts": 0,
    "max_restart_delay_seconds": 60
  },

  "output": {
    "playlist_file": "live_playlist.m3u",
    "log_directory": "logs",
    "log_file": "stream_manager.log"
  },

  "facebook": {
    "enabled": true,
    "page_id": "",
    "page_access_token": "",
    "post_message": false
  },

  "ffmpeg": {
    "enabled": true,

    "duration_minutes": 180,

    "video": {
      "width": 1920,
      "height": 1080,
      "fps": 29.97,
      "bitrate": "4500k",
      "maxrate": "5500k",
      "bufsize": "10000k",
      "preset": "veryfast",
      "eq": {
        "brightness": 0.02,
        "contrast": 1.03,
        "saturation": 1.05
      },
      "noise": {
        "enabled": true,
        "alls": 3,
        "allf": "t+u"
      },
      "crop": {
        "enabled": true,
        "width_factor": 0.96,
        "height_factor": 0.96
      }
    },

    "overlay": {
      "enabled": true,

      "logo": "assets/logo.png",

      "logo_width": 380,

      "logo_position": {
        "x": 1490,
        "y": 65
      },

      "frame": {
        "enabled": true,
        "width": 55,
        "color": "0xFF0000",
        "opacity": 1.0
      },

      "watermark": {
        "enabled": true,
        "opacity": 0.25,
        "width": 700,
        "move_distance_x": 0,
        "move_distance_y": 0,
        "move_speed": 0.0
      },

      "live_badge": {
        "enabled": true,
        "text": "LIVE",
        "x": 35,
        "y": 220,
        "font_size": 42,
        "font_color": "white",
        "box_color": "0x8B0000",
        "box_opacity": 0.85
      }
    },

    "audio": {
      "enabled": true,

      "mode": "young",

      "volume": 1.05,

      "bass": -8,

      "treble": 12,

      "speed_and_pitch": {
        "asetrate": "48000*1.015",
        "aresample": 48000
      },

      "filters": {
        "highpass": 100,
        "lowpass": 14000
      },

      "echo": {
        "enabled": false,
        "in_gain": 0.60,
        "out_gain": 0.40,
        "delays": "60|60",
        "decays": "0.05|0.05"
      }
    }
  }
}
